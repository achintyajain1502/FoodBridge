PORT=5000

# Hosted PostgreSQL connection (recommended: Neon, Supabase, or Render)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local PostgreSQL fallback
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_donation
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Password-reset emails (Brevo)
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=FoodBridge
FRONTEND_URL=http://localhost:5173
